{
  "cli": {
    "version": ">= 14.1.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://tourist-safety-monitoring-system.onrender.com",
        "BACKEND_URL": "https://tourist-safety-monitoring-system.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
